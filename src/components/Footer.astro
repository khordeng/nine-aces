---
import { siteConfig } from "../config/site.config";
import { t } from "../lib/i18n";
import { hasValue, instagramLink, tiktokLink } from "../lib/site";

const socials = [
  hasValue(siteConfig.instagram) && { label: "Instagram", handle: `@${siteConfig.instagram}`, href: instagramLink() },
  hasValue(siteConfig.tiktok) && { label: "TikTok", handle: `@${siteConfig.tiktok}`, href: tiktokLink() },
].filter(Boolean) as { label: string; handle: string; href: string }[];
---

<footer class="border-t border-line bg-bg py-12 md:py-14">
  <div class="container-x flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="eyebrow">Nine Aces Pool &amp; Cafe</p>
      {hasValue(siteConfig.shortAddress) && <p class="mt-3 text-sm text-text-2">{siteConfig.shortAddress}</p>}
    </div>
    <div class="flex flex-col gap-4 md:items-end">
      {socials.length > 0 && (
        <ul class="flex flex-wrap gap-x-6 gap-y-1" data-i18n-attr="aria-label:footer.social" aria-label={t("footer.social")}>
          {socials.map((s) => (
            <li>
              <a class="footer-link" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} ${s.handle}`}>
                {s.handle}
              </a>
            </li>
          ))}
        </ul>
      )}
      <p class="text-[12px] text-muted" data-i18n="footer.rights">{t("footer.rights")}</p>
    </div>
  </div>
</footer>
